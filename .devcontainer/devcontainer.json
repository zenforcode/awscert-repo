{
    "name": "Python 3.10 DevContainer",
    "build": {
      "dockerfile": "Dockerfile"
    },
    "settings": {
      "python.defaultInterpreterPath": "/usr/local/bin/python"
    },
    "extensions": [
      "ms-python.python",
      "ms-python.vscode-pylance"
    ],
    "containerEnv": {
      "DEBUG": true
    },
    "remoteUser": "vscode",
    "runArgs": ["--env-file",".devcontainer/.env"]
}

